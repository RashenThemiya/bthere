        <mxCell id="n9" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;06 / PROVIDER REQUIREMENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Field codes / types: _________________&lt;br&gt;MANUAL or PROVIDER_PROFILE: ______&lt;br&gt;Required / approval rules: ____________&lt;br&gt;reuseScope per field: ________________&lt;br&gt;Filter-visible choices: _______________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
