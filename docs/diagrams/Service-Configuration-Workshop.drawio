<mxfile host="app.diagrams.net" agent="CareHub workshop generator" version="24.7.17" type="device">
  <diagram id="page-1" name="01 — System &amp; ownership map">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;01 — System &amp;amp; ownership map&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start here: decide what belongs to the main service, shared option, provider and booking.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;LEGEND / STATUS&lt;/b&gt;&lt;br&gt;&lt;br&gt;BLUE = existing backend configuration (local code; deployment not verified)&lt;br&gt;ORANGE = proposed design, not implemented | YELLOW = discussion / fill in | GREEN = example only&lt;br&gt;Editable workshop template • 23 Oct 2026 • IDs, prices and examples are illustrative&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="1520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;MAIN SERVICE — navigation + common setup&lt;/b&gt;&lt;br&gt;&lt;br&gt;Examples: Caregiver / Ride / Cleaning&lt;br&gt;Identity: serviceTypeId, name, description&lt;br&gt;Media: icon, cover, gallery, marker default&lt;br&gt;Common registration: availability, areas, skills,&lt;br&gt;certificates, education, common documents&lt;br&gt;Option selection: required / min / max&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="490" height="285" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;SERVICE ↔ OPTION LINK&lt;/b&gt;&lt;br&gt;&lt;br&gt;One shared optionId can appear in many services.&lt;br&gt;Example: Care Ride → Ride AND Caregiver&lt;br&gt;Link settings: displayOrder + status&lt;br&gt;Do not copy option fields or prices per link.&lt;br&gt;Main-service common policies remain distinct.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="555" y="300" width="490" height="285" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;SHARED OPTION — reusable configuration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Identity + media + responsibilities&lt;br&gt;Scheduling / delivery / fulfillment / capacity&lt;br&gt;Provider fields + booking fields + document rules&lt;br&gt;Payment configuration + price ownership&lt;br&gt;Conditional rates + combination marker rules&lt;br&gt;Historical owner = configuration namespace&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="300" width="490" height="285" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="contains links" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="references one optionId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;PROVIDER REGISTRATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Provider selects option and supplies capabilities.&lt;br&gt;Requirements: answers + documents + reviews&lt;br&gt;Operational source: availability + areas + location&lt;br&gt;One provider enrollment per shared option&lt;br&gt;Find shared registration; do not register again&lt;br&gt;just because another main service links to it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="490" height="285" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;CUSTOMER WORKFLOW&lt;/b&gt;&lt;br&gt;&lt;br&gt;Service → option → booking schema&lt;br&gt;Select time OR route + delivery details&lt;br&gt;Apply configured provider filters&lt;br&gt;Search eligible providers / configured team&lt;br&gt;Quote → select payment → create booking&lt;br&gt;Booking answers belong to the customer job.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="555" y="670" width="490" height="285" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;PRICING + MAP PRESENTATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rate conditions reference fieldId + choiceValue.&lt;br&gt;CAR + MALE can have a specific fare.&lt;br&gt;Marker rules use a combination of choices.&lt;br&gt;Service icon ≠ map marker icon.&lt;br&gt;Shared option means consistent rules from&lt;br&gt;each linked service entry point.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="670" width="490" height="285" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="registration contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="customer schema" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="shared rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="eligible candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;EXAMPLE RELATIONSHIP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ride (service 2) ─┐&lt;br&gt;                  ├─ Care Ride (option 4): ONE shared definition&lt;br&gt;Caregiver (1) ────┘&lt;br&gt;Vehicle Type + Licence requirements + Passenger Count + CAR pricing/marker rules are reused.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1005" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;DISCUSSION DECISIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Service list: ______________________&lt;br&gt;Shared option list: _________________&lt;br&gt;Who configures prices? ______________&lt;br&gt;Provider registration owner/source? ___&lt;br&gt;Decision owner / date: ______________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1060" width="490" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;BOUNDARY / AVOID ASSUMPTIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;The proposed global FIELD catalog is a separate future layer (page 07). Shared OPTION configuration already exists locally.&lt;br&gt;An enum being accepted does not prove the complete matching/payment workflow is deployed.&lt;br&gt;Existing Front/Back document types are preserved; they are not automatically consolidated by name.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1340" width="1520" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
