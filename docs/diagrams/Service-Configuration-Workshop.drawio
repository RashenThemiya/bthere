        <mxCell id="n2" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;03 — Configuration enums&lt;/b&gt;&lt;br&gt;&lt;br&gt;Values below are from local backend validation. Configuration support is not a deployment guarantee.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
