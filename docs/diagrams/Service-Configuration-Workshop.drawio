        <mxCell id="n5" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;02 / OPTION &amp;amp; LINKS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Code / name / optionId: ______________&lt;br&gt;Original configuration service: _______&lt;br&gt;Linked main services: _______________&lt;br&gt;Link order / active status: ___________&lt;br&gt;Description / responsibilities: _________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="555" y="300" width="490" height="290" as="geometry" />
