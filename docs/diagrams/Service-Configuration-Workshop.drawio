        <mxCell id="n8" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;05 / CAPACITY &amp;amp; SELECTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;fulfillmentModel: ___________________&lt;br&gt;defaultCapacity: ___________________&lt;br&gt;requiredProviderCount: ______________&lt;br&gt;bookingMode: _____________________&lt;br&gt;providerSelectionMode: ______________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
