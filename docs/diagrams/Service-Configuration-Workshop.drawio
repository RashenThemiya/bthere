        <mxCell id="n6" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;03 / DELIVERY &amp;amp; LOCATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;deliveryModes: _____________________&lt;br&gt;locationEnabled: ___________________&lt;br&gt;Provider address / meeting point: _____&lt;br&gt;Coverage centre + radius: ____________&lt;br&gt;Online or physical workflow: __________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
