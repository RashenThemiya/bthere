        <mxCell id="n12" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;09 / PRICING &amp;amp; PAYMENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;pricingOwner: _____________________&lt;br&gt;billingType / durationMinutes: _________&lt;br&gt;Rate or base/per-km/minimum: _________&lt;br&gt;Choice combinations / market / area: ___&lt;br&gt;Allowed methods / actual integration: ___&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
