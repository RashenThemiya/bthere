        <mxCell id="n10" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;07 / DOCUMENTS &amp;amp; PARTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Document type(s): __________________&lt;br&gt;Parts: FRONT / BACK / other: _________&lt;br&gt;Required + count + MIME + size: ______&lt;br&gt;Issued/expiry date modes: ____________&lt;br&gt;Bundle review required? ______________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
