        <mxCell id="n7" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;04 / SCHEDULING&lt;/b&gt;&lt;br&gt;&lt;br&gt;schedulingModel: __________________&lt;br&gt;TIME: start / end / duration: __________&lt;br&gt;ROUTE: pickup / destination: __________&lt;br&gt;Route average speed: _______________&lt;br&gt;Availability constraints: ______________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
