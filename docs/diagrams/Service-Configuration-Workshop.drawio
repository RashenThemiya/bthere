        <mxCell id="n4" value="&lt;div style=&quot;text-align:left;padding:12px&quot;&gt;&lt;b&gt;01 / MAIN SERVICE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Name / serviceTypeId: ______________&lt;br&gt;Description / audience: ______________&lt;br&gt;Common requirements: ______________&lt;br&gt;Option min / max selections: _________&lt;br&gt;Availability / areas enabled: _________&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#0f172a;verticalAlign=top;align=left;spacing=4;arcSize=8;" vertex="1" parent="1">
