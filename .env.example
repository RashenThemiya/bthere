DB_URL=jdbc:mysql://distribution-system-mysql-1:3306/jobhub?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=jobhub
DB_PASSWORD=replace_with_jobhub_database_password
APP_PORT=8083
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@jobhub.local
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
OTP_HASH_SECRET=replace_with_another_random_secret_at_least_32_characters
AWS_REGION=ap-south-1
TEXTLK_API_TOKEN=replace_with_textlk_api_token
TEXTLK_SENDER_ID=CareHub
TEXTLK_API_ENDPOINT=https://app.text.lk/api/v3/sms/send
AWS_SES_FROM_EMAIL=no-reply@example.com
# Mail Manager ingress SMTP settings (not used by the current SES API email sender).
SMTP_HOST=your-mail-manager-ingress-endpoint.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS=true
AWS_EC2_METADATA_V1_DISABLED=true
AWS_S3_BUCKET=jobhub-images
AWS_S3_REGION=ap-south-1
# Optional CloudFront/custom URL. Leave empty to use the standard S3 URL.
AWS_S3_PUBLIC_BASE_URL=
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=10MB
DEFAULT_MARKET_NAME=Sri Lanka
DEFAULT_MARKET_COUNTRY_CODE=LK
DEFAULT_MARKET_CURRENCY=LKR
DEFAULT_MARKET_TIMEZONE=Asia/Colombo
DEFAULT_MARKET_LOCALE=en-LK
DEFAULT_MARKET_PHONE_CODE=+94
